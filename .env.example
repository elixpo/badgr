# ==============================================================================
# OreoOS Environment Configuration Example
# Copy this file to `.env` and fill in your credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. WiFi Configuration
# ------------------------------------------------------------------------------
WIFI_SSID=YourWiFiNetworkName,HotspotName
WIFI_PASSWORD=YourWiFiPassword,HotspotPassword
WIFI_AUTO_CONNECT=True
DEBUG=True

# ------------------------------------------------------------------------------
# 2. Location & Timezone
# ------------------------------------------------------------------------------
WEATHER_LAT=22.57
WEATHER_LON=88.36
WEATHER_NAME=Kolkata
TIMEZONE_OFFSET=5.5

# ------------------------------------------------------------------------------
# 3. API Integrations & Cloud Services
# ------------------------------------------------------------------------------
# OpenWeatherMap API Key (used by Weather app)
OWM_API_KEY=your_open_weather_map_api_key_here
OWM_API_URL=https://api.openweathermap.org

# GitHub Personal Access Token (used for Commits & Badge stats)
GH_TOKEN=your_github_pat_token_here
GITHUB_API_URL=https://api.github.com

# System Endpoints (OTA Updates, App Store, Time Sync)
GITHUB_REPO=elixpo/oreo
OTA_REPO=elixpo/oreo
STORE_REPO=elixpo/oreo
NTP_HOST=pool.ntp.org

# Spotify Connect Cloud Relay (used by Spotify app)
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_RELAY_URL=https://oreo-delta.vercel.app
SPOTIFY_AUTH_URL=https://oreo-delta.vercel.app/spotify

# ------------------------------------------------------------------------------
# 4. Identity & Public Social Channels
# ------------------------------------------------------------------------------
DISPLAY_NAME=Octo Cat
DESIGNATION=Software Engineer

# Standard Profile Shortcuts
GITHUB_USER=octocat
TWITTER_USER=octocat
LINKEDIN_USER=octocat
BLUESKY_USER=octocat.bsky.social
NPM_USER=octocat
WEBSITE_URL=https://octocat.github.io
EMAIL=octocat@github.com

# Agnostic Custom Links: add ANY platform with LINK_<NAME>=URL or SOCIAL_<NAME>=URL
# LINK_DISCORD=https://discord.gg/yourserver
# LINK_CALENDLY=https://calendly.com/yourhandle
# SOCIAL_TWITCH=https://twitch.tv/yourchannel
