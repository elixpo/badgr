# OreoOS Environment Configuration Example
# Copy this file to `.env` and fill in your credentials.

# ------------------------------------------------------------------------------
# WiFi Configuration
# ------------------------------------------------------------------------------
# Comma-separated list of WiFi SSIDs to auto-connect to (in priority order)
WIFI_SSID=YourWiFiNetworkName,HotspotName

# Parallel comma-separated list of passwords corresponding to the SSIDs above
WIFI_PASSWORD=YourWiFiPassword,HotspotPassword

# Set to False to disable WiFi auto-connect on boot
WIFI_AUTO_CONNECT=True

# Set to True/1 for verbose stack trace logging on errors, or False/0 for single-line error summaries
DEBUG=True

# ------------------------------------------------------------------------------
# API Keys & Integrations
# ------------------------------------------------------------------------------
# OpenWeatherMap API Key (used by the Weather app)
OWM_API_KEY=your_open_weather_map_api_key_here

# GitHub Personal Access Token (used for fetching GitHub commits, stars, & badge stats)
GH_TOKEN=your_github_pat_token_here

# ------------------------------------------------------------------------------
# Location & Time
# ------------------------------------------------------------------------------
# Latitude and Longitude for Weather forecasts
WEATHER_LAT=22.57
WEATHER_LON=88.36

# Timezone Offset in hours from UTC (e.g. 5.5 for IST, -5 for EST)
TIMEZONE_OFFSET=5.5

# ------------------------------------------------------------------------------
# Social Media & Identity (used by Identity & QR Card apps)
# ------------------------------------------------------------------------------
GITHUB_USER=octocat
DISPLAY_NAME=Octo Cat
DESIGNATION=Software Engineer
LINKEDIN_USER=octocat
TWITTER_USER=octocat
BLUESKY_USER=octocat.bsky.social
NPM_USER=octocat
WEBSITE_URL=https://octocat.github.io
EMAIL=octocat@github.com
